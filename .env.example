# Octopus Energy credentials (required)
OCTOPUS_API_KEY=sk_live_xxx
OCTOPUS_ACCOUNT=A-XXXXXXXX

# Electricity meter (optional, for consumption data)
OCTOPUS_MPAN=1234567890123
OCTOPUS_METER_SERIAL=12A3456789

# Gas meter (optional, for gas consumption)
OCTOPUS_GAS_MPRN=1234567890
OCTOPUS_GAS_METER_SERIAL=G4A12345

# Google Gemini AI agent (optional, for octopus-ask)
GEMINI_API_KEY=AIzaSy...

# Device Config
OCTOPUS_REGION=L
OCTOPUS_DEVICE_ID=00000000-0000-0000-0000-000000000000

# Watch Timeout (seconds) - Set to 0 to disable
OCTOPUS_WATCH_TIMEOUT=300
